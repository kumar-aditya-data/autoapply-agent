# Copy to .env and fill in. Never commit .env.

# Anthropic credentials: the SDK reads this itself; autoapply never logs it.
# Uncomment and set it, OR run `ant auth login` and leave it commented out
# (an empty value would override an `ant` login profile).
# ANTHROPIC_API_KEY=

# Model ID (required, not hardcoded anywhere in the code).
# Use `baseline` to run the free offline baseline (no API key, no LLM).
AUTOAPPLY_MODEL=claude-opus-5-5

# Reasoning effort: low | medium | high | xhigh | max
AUTOAPPLY_EFFORT=medium

# How many times the Writer may auto-revise after a failed review before a human sees it.
AUTOAPPLY_MAX_AUTO_REVISIONS=1

# Server-side refusal fallback (Claude API). Set false for models that do not support it.
AUTOAPPLY_REFUSAL_FALLBACK=true

# Where checkpoints, token logs and approved outputs are stored.
AUTOAPPLY_DATA_DIR=.autoapply
